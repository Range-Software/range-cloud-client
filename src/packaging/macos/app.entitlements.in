<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mandatory for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Must match the provisioning profile embedded in the bundle; without them
	     App Store Connect rejects the upload (ITMS-90886). -->
	<key>com.apple.application-identifier</key>
	<string>@MACOS_TEAM_ID@.@MACOS_BUNDLE_IDENTIFIER@</string>
	<key>com.apple.developer.team-identifier</key>
	<string>@MACOS_TEAM_ID@</string>
	<!-- Connections to Range Cloud servers. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Certificates and private keys chosen in the session settings, and local
	     folders exchanged with Range Cloud, selected through a file dialog. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
